{
  "name": "apps-biblicas",
  "version": "1.0.0",
  "description": "Suite de aplicaciones interactivas sobre la Biblia (cronología, genealogías, historia y manuscritos)",
  "private": true,
  "scripts": {
    "dev": "npx serve .",
    "start": "npx serve .",
    "test": "node scripts/validate.js && node scripts/i18n-check.js",
    "i18n:check": "node scripts/i18n-check.js",
    "i18n:new": "node scripts/i18n-new.js"
  },
  "keywords": [
    "biblia",
    "cronologia",
    "historia",
    "manuscritos",
    "reyes",
    "genealogias",
    "bible-apps",
    "vercel"
  ],
  "author": "rmenor",
  "license": "MIT",
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.5.0",
    "@neondatabase/serverless": "^1.2.0"
  }
}
