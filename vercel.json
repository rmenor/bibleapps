{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/cronologia",
      "destination": "/apps/cronologia/",
      "permanent": true
    },
    {
      "source": "/cronologia/:path*",
      "destination": "/apps/cronologia/:path*",
      "permanent": true
    },
    {
      "source": "/atlas",
      "destination": "/apps/atlas/",
      "permanent": true
    },
    {
      "source": "/atlas/:path*",
      "destination": "/apps/atlas/:path*",
      "permanent": true
    },
    {
      "source": "/medidas",
      "destination": "/apps/medidas/",
      "permanent": true
    },
    {
      "source": "/medidas/:path*",
      "destination": "/apps/medidas/:path*",
      "permanent": true
    },
    {
      "source": "/pesas-y-medidas",
      "destination": "/apps/medidas/",
      "permanent": true
    },
    {
      "source": "/pesas-y-medidas/:path*",
      "destination": "/apps/medidas/:path*",
      "permanent": true
    },
    {
      "source": "/notas",
      "destination": "/apps/notas/",
      "permanent": true
    },
    {
      "source": "/notas/:path*",
      "destination": "/apps/notas/:path*",
      "permanent": true
    },
    {
      "source": "/creacion",
      "destination": "/apps/creacion/",
      "permanent": true
    },
    {
      "source": "/creacion/:path*",
      "destination": "/apps/creacion/:path*",
      "permanent": true
    },
    {
      "source": "/apps/cronologia",
      "destination": "/apps/cronologia/",
      "permanent": true
    },
    {
      "source": "/apps/atlas",
      "destination": "/apps/atlas/",
      "permanent": true
    },
    {
      "source": "/apps/medidas",
      "destination": "/apps/medidas/",
      "permanent": true
    },
    {
      "source": "/apps/notas",
      "destination": "/apps/notas/",
      "permanent": true
    },
    {
      "source": "/apps/creacion",
      "destination": "/apps/creacion/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/apps/cronologia/",
      "destination": "/apps/cronologia/index.html"
    },
    {
      "source": "/apps/atlas/",
      "destination": "/apps/atlas/index.html"
    },
    {
      "source": "/apps/medidas/",
      "destination": "/apps/medidas/index.html"
    },
    {
      "source": "/apps/notas/",
      "destination": "/apps/notas/index.html"
    },
    {
      "source": "/apps/creacion/",
      "destination": "/apps/creacion/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/apps/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
